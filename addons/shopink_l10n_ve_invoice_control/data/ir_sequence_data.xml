<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Secuencia oficial para los números de control de facturas de clientes en Odoo 19 -->
    <record id="sequence_l10n_ve_control_number" model="ir.sequence">
        <name>Secuencia Número de Control Venezuela</name>
        <field name="code">l10n_ve.control.number</field>
        <field name="prefix">00-</field>
        <field name="padding">8</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="use_date_range" eval="False"/>
    </record>
</odoo>
