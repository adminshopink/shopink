<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_usd_ves_sheets" model="ir.cron">
            <name>Sincronización de Tasa USD/VES desde Google Sheets</name>
            <model_id ref="base.model_res_currency"/>
            <state>code</state>
            <code>model.action_sync_usd_ves_sheets()</code>
            <interval_number>1</interval_number>
            <interval_type>days</interval_type>
            <numbercall>-1</numbercall>
            <doall eval="False"/>
            <active eval="True"/>
            <nextcall eval="(datetime.now().replace(hour=6, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
